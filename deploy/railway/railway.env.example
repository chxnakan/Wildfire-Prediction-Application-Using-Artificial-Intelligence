# Paste into Railway: service > Variables > Raw Editor.
# Never commit a real MAP_KEY; set it only in Railway.

# Port the app listens on; use the same number when generating the domain.
PORT=8000

# NASA FIRMS MAP_KEY for the Live Fires feed. Forecasts display without it.
FIRMS_API_KEY=YOUR_FIRMS_API_KEY_HERE
FIRMS_BBOX=96,4,107,22
