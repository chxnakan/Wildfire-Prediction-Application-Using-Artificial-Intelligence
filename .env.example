# ===============================
# PROJECT
# ===============================
PROJECT_NAME=fire-risk-prediction
PROJECT_ROOT=.

# ===============================
# DATA PATHS
# ===============================
DATA_DIR=./data
RAW_DIR=./data/raw
FIRMS_DIR=./data/firms
FIRMS_PATH=./data/firms/firms_all.parquet
WEATHER_DIR=./data/weather
# Open-Meteo Archive API — no key/token. Tune if you hit HTTP 429 (rate limit):
# OPEN_METEO_MAX_WORKERS=3
# OPEN_METEO_BATCH_SIZE=1
# OPEN_METEO_APP_RETRIES=8
# OPEN_METEO_UNIT_RETRIES=5
# OPEN_METEO_FLUSH_EVERY=20
# OPEN_METEO_FINAL_RETRY_ROUNDS=15
# OPEN_METEO_RETRY_ROUND_SLEEP_BASE=45
# Prefer off-peak (Asia/Bangkok wall clock, inclusive hours): script sleeps first
# OPEN_METEO_QUIET_HOURS=2-8

# GISTDA ArcGIS REST (no key) — optional; see docs/DATA_APIS_TH.md
# Run: cd src && python fetch_gistda_hotspots.py
# Or: ./run.sh --gistda

# ===============================
# OUTPUT PATHS
# ===============================
OUTPUT_DIR=./outputs
MODEL_DIR=./outputs/models
RISKMAP_DIR=./outputs/riskmap
REPORT_DIR=./outputs/reports

# ===============================
# GRID / MODEL CONFIG
# ===============================
# Spatial resolution of the prediction grid (in degrees). Smaller = more
# precise, but cascades through the whole pipeline. After changing this you
# MUST re-run: fetch_weather.py → train.py → risk_map.py.
#   0.1   ≈ 11 km   ~500–2,000 cells   (default, fastest)
#   0.05  ≈ 5.5 km  ~2k–8k cells       (recommended sweet spot)
#   0.025 ≈ 2.7 km  ~8k–32k cells      (sharp; ~30–90 min training)
#   <0.02 → diminishing returns; FIRMS VIIRS native resolution is ~375 m
#           but the detection signal saturates well before that grid size.
GRID_SIZE=0.1
RANDOM_STATE=42
# Latest N calendar days of densified FIRMS history for train.py (0 = full range).
# MAX_TRAIN_HISTORY_DAYS=180

# ===============================
# FIRMS (NASA)
# ===============================
FIRMS_API_KEY=YOUR_FIRMS_API_KEY_HERE
FIRMS_BBOX=96,4,107,22
FIRMS_DAYS=1

# ===============================
# TRAINING
# ===============================
TEST_SIZE=0.2
N_ESTIMATORS=500
LEARNING_RATE=0.05
NUM_LEAVES=31
MIN_CHILD_SAMPLES=50

# ===============================
# BACKEND / METADATA
# ===============================
TIMEZONE=Asia/Bangkok
DATE_FORMAT=%Y-%m-%d

# ===============================
# DASHBOARD FILTERS (risk_map.py)
# ===============================
# Three sequential filters drop cells before the dashboard renders them.
# Lower thresholds = more cells shown but more noise. Tune to taste.
#
# Short-window: cells must have ≥ N fires in the last 30 days
MIN_HISTORICAL_FIRES_FOR_DISPLAY=1
# Long-window: cells must have ≥ N fires in the last LONG_HISTORY_WINDOW_DAYS
LONG_HISTORY_WINDOW_DAYS=90
MIN_LONG_HISTORICAL_FIRES=3
# Climatological fire-rate: cells must have ≥ N fire-days per year
# (annualized over the full FIRMS record). The strongest "is this place
# actually fire-prone?" filter — drops cells that the model wants to
# predict on but which have essentially never burned. 1.0 is conservative;
# try 2.0–3.0 for a tight focus on real hotspots, 0 to disable.
MIN_FIRE_DAYS_PER_YEAR=1.0

# Urban-exclusion: drop predictions that fall inside major Thai cities.
# FIRMS detects garbage burning, industrial heat, and other non-wildfire
# heat sources in cities — predicting "wildfire in central Bangkok" is
# misleading. Set URBAN_FILTER_ENABLED=false to disable. URBAN_BUFFER_KM
# adds extra exclusion distance beyond each city's hand-tuned radius.
# The list of cities is in src/urban_areas.py — edit to add/remove cities.
URBAN_FILTER_ENABLED=true
URBAN_BUFFER_KM=0.0

# ===============================
# AUTOMATION (Railway deployment)
# ===============================
# PostgreSQL archive — Railway injects DATABASE_URL automatically when a
# PostgreSQL service is attached. Leave unset for local dev (all DB writes
# become no-ops; parquet + GeoJSON keep working exactly as before).
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# Background scheduler inside the FastAPI process (see src/scheduler.py).
# Set false when running the API locally and you don't want auto-fetching.
SCHEDULER_ENABLED=true
# Per-job switches. Defaults remain true when omitted. For a presentation-safe
# GISTDA-only process use run.sh --demo instead of editing these by hand.
SCHEDULER_SYNC_ENABLED=true
SCHEDULER_RETRAIN_ENABLED=true
SYNC_INTERVAL_MINUTES=10
RETRAIN_EVERY_DAYS=3
RETRAIN_CHECK_HOURS=6
TRAIN_ARGS=--quick
PREDICT_MAX_HISTORY_DAYS=180

# ===============================
# PRODUCTION SAFETY (security.py) — Phase 1
# ===============================
# Master switch. "production" flips every strict default below to fail-closed.
# Leave unset / "development" for local work (endpoints open, CORS = localhost).
APP_ENV=development

# Privileged endpoints: /api/admin/* and /api/notify*.
#   dev  (APP_ENV != production): unset ⇒ OPEN for convenience.
#   prod (APP_ENV = production):  unset ⇒ endpoints return 503 (FAIL CLOSED).
# Callers pass the value in the `X-Admin-Token` request header.
# ADMIN_TOKEN=change-me

# CORS allowlist (comma-separated origins). No wildcard is ever used.
# In production an empty value fails closed (no cross-origin browser access).
# CORS_ALLOW_ORIGINS=https://your-app.vercel.app

# Content-Security-Policy tuning (defaults are Leaflet + CARTO-tile compatible).
# CSP_TILE_HOSTS=https://*.basemaps.cartocdn.com
# CSP_CONNECT_SRC=            # extra hosts the browser may fetch/XHR/SSE to

# Rate limits (requests per 60 s per client IP, per route class). Best-effort,
# in-process (per replica — no Redis dependency).
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_ADMIN=20
RATE_LIMIT_STREAM=10

# Readiness: /health/ready is 503 unless the GeoJSON is fresher than this.
READY_GEOJSON_MAX_AGE_DAYS=7

# ===============================
# GISTDA LIVE HOTSPOTS (observed detections layer — NOT predictions)
# ===============================
# Server-side poller (scheduler.py) pulls GISTDA's ArcGIS layers and caches
# to PostgreSQL (live_hotspots). The browser only ever reads OUR cache via
# /live-hotspots. Multiple Railway replicas are safe: a PostgreSQL advisory
# lock ensures exactly one instance polls per cycle (without a DB the lock
# is process-local — fine for local dev, use Postgres in production).
GISTDA_ENABLED=true
GISTDA_POLL_SECONDS=300
CLIENT_REFRESH_SECONDS=60
GISTDA_RETENTION_DAYS=7
GISTDA_REQUEST_TIMEOUT_SECONDS=15
GISTDA_MAX_RETRIES=4
GISTDA_STALE_AFTER_SECONDS=900
# Event dedupe: detections within ~110 m (3 decimals) and 10 min are one event
# GISTDA_EVENT_DEDUPE_DECIMALS=3
# GISTDA_EVENT_TIME_TOLERANCE_S=600

# ── GISTDA event identity + validation (see src/gistda_client.py docstring) ──
# Identity grid cell size (m) + time bucket (s): detections in the same
# cell+bucket are ONE physical event. Changing these changes event IDs.
GISTDA_EVENT_DISTANCE_METERS=375
GISTDA_EVENT_TIME_TOLERANCE_SECONDS=600
# Drop detections outside Thailand's land border (+ tolerance for border pixels)
GISTDA_REQUIRE_IN_THAILAND=true
GISTDA_BORDER_TOLERANCE_KM=2.0

# ── Model promotion quality gates (train.py STEP 9b) ──
MODEL_GATE_MIN_AUC=0.65
MODEL_GATE_MIN_AP_UPLIFT=1.5
MODEL_GATE_MAX_AUC_DROP=0.02

# ── Operational alert thresholds (thresholds.py, chosen on calib only) ──
# HIGH = F1-optimal (precision-oriented urgent alert).
# WATCH = lowest cutoff catching >= WATCH_TARGET_RECALL of calibration fires
#         (recall-oriented monitoring list). MEDIUM is an alias of WATCH.
WATCH_TARGET_RECALL=0.90
# Optional precision floor for WATCH (unset = no guard). If set, WATCH is
# raised to the highest-recall cutoff that still meets this precision.
# WATCH_MIN_PRECISION=0.30
# Base-rate drift is flagged when calib vs recent prevalence differ by >= this
# ratio (either direction). Surfaced in metrics + the dashboard.
DRIFT_PREVALENCE_RATIO=3.0

# ── Audited training experiment knobs (docs/AUDIT_BOTTLENECKS.md) ──
# Class-imbalance handling — balancing applied exactly once except legacy D:
#   A natural prevalence, no weighting (memory-heavy)
#   B natural prevalence + scale_pos_weight only (memory-heavy)
#   C 4:1 undersampling + analytic prior correction (recommended candidate)
#   D legacy stacked behaviour (default, backward-compatible)
IMBALANCE_MODE=D
# Hyperparameter-search objective (threshold selection stays calib-only).
TUNE_SCORING=average_precision
# >0 inserts a dedicated PROMOTION/champion block between calib and test
# (5-way split) so promotion decisions never touch the final test.
CHAMPION_FRACTION=0.0
# Emit causal {col}_missing weather indicators (changes feature contract —
# enable only with a reviewed retrain).
WEATHER_MISSING_INDICATORS=false
# multi-satellite label weighting (estimand note in audit item 9).
MULTISAT_WEIGHTING=true
