{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Host wildfire dashboard",
			"type": "process",
			"command": "${workspaceFolder}/.venv/bin/python",
			"args": [
				"-m",
				"uvicorn",
				"src.api:app",
				"--reload",
				"--host",
				"127.0.0.1",
				"--port",
				"8000"
			],
			"options": { "cwd": "${workspaceFolder}" },
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}
